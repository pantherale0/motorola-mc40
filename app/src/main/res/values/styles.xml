<resources>
    <style name="Theme.Mc40" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/text_dim</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorPrimary">@color/bg_panel</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="editTextStyle">@style/Mc40EditText</item>
    </style>

    <style name="Mc40EditText" parent="Widget.AppCompat.EditText">
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/text_dim</item>
        <item name="android:textSize">16sp</item>
        <item name="android:padding">10dp</item>
        <item name="android:background">@drawable/edit_bg</item>
    </style>
</resources>
